config_version=5

[application]

config/name="roll-full"
run/main_scene="uid://nd8r32rdw4fb"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bpvw5l4y871tk"

[autoload]

Global="*uid://2epbr11ss74w"

[display]

window/size/viewport_height=864
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-hackatime/plugin.cfg", "res://addons/godot-hackatime/tracker/plugin.cfg")

[global_group]

Main=""
Player=""
Level=""
Themed=""
Saveable=""

