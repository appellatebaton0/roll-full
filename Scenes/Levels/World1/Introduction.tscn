[sub_resource type="GDScript" id="GDScript_oo7f2"]
script/source = "extends Node
## Only show the relevant node for the current input type.

@export var nodes:Dictionary[Global.INPUT_TYPE, Node2D]

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	Global.input_type_changed.connect(_type_changed)
	_type_changed()

func _type_changed() -> void:
	
	for type in nodes:
		if type == Global.input_type:
			nodes[type].show()
		else:
			nodes[type].hide()
"

