[sub_resource type="GDScript" id="GDScript_aecy5"]
script/source = "extends Area2D
## Ensures the ray snapping is disabled here.

# Called when the node enters the scene tree for the first time.
func _process(_delta: float) -> void:
	for body in get_overlapping_bodies(): if body is Player:
		# Reset the ray target so the player disconnects from the wall.
		body.ray_node.target_position = Vector2.ZERO
		body.ray_fall_time = 1.0
"

