[sub_resource type="GDScript" id="GDScript_4bv08"]
script/source = "extends TextureButton

func _pressed() -> void: Global.request_animation.emit(\"Editor->Main\")

func _ready() -> void:
	focus_entered.connect(_focused)
	mouse_entered.connect(_focused)
	
	focus_exited.connect(_unfocused)
	mouse_exited.connect(_unfocused)
	pass

func _focused()   -> void: modulate = Color(\"a9c7f5ff\")
func _unfocused() -> void: modulate = Color(\"89b4f4\")

func _make_custom_tooltip(for_text: String) -> Object:
	return Global._make_custom_tooltip(for_text)
"

