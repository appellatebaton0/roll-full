[sub_resource type="GDScript" id="GDScript_yne6l"]
script/source = "extends CheckButton

func _ready() -> void:
	button_pressed = Global.spinning_camera

func _toggled(toggled_on: bool) -> void:
	Global.spinning_camera = toggled_on
"

[sub_resource type="GDScript" id="GDScript_d2mda"]
script/source = "extends CheckButton

func _ready() -> void:
	button_pressed = Global.do_parallaxing

func _toggled(toggled_on: bool) -> void:
	Global.do_parallaxing = toggled_on
"

