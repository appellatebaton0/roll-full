[sub_resource type="GDScript" id="GDScript_3v8qa"]
script/source = "extends TextureButton
## Allow for a packed scene to be loaded into a subviewport.

@export var viewport:SubViewport
@export var scene:PackedScene
@export var manip:Node

func _pressed() -> void:
	var instance := scene.instantiate()
	
	viewport.add_child(instance)
	
	manip.add_target(instance)
"

[sub_resource type="GDScript" id="GDScript_tpxhb"]
script/source = "extends Node
# Allow everything user-made to have its position manipulated?

var selected:Node2D
var held := false
var hold_offset:Vector2

var targets:Array[ScenePlaceholder]

func add_target(node:ScenePlaceholder):
	
	targets.append(node)
	
	node.mouse_detector.input_event.connect(_input_event.bind(node))

func _process(delta: float) -> void:
	if held: selected.global_position = selected.get_global_mouse_position() - hold_offset

func _input_event(_viewport: Node, event: InputEvent, _shape_idx: int, node: ScenePlaceholder) -> void:
	if event is InputEventMouseButton:
		if event.is_pressed():
			print(event.position)
			print(\"START DRAG\")
			hold_offset = node.get_local_mouse_position()
			selected = node
			held = true
			
			# Move to the end of the child list. In other words, put on top.
			node.get_parent().move_child(node, -1)
		elif held: held = false
	
		get_viewport().set_input_as_handled()
"

