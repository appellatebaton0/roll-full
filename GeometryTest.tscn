[gd_scene format=3 uid="uid://bp7w4qyjj1ftf"]

[sub_resource type="GDScript" id="GDScript_ywug1"]
script/source = "@tool
extends Line2D

var colliders:Array[CollisionPolygon2D]


@export var offset := 0.0:
	set(to):
		offset = to
		regenerate.call()
@export_tool_button(\"REGENERATE\", \"Line2D\") var regenerate = func():
	
	var polygons := Geometry2D.offset_polyline(points, offset, Geometry2D.JOIN_SQUARE, Geometry2D.END_BUTT)
	
	var fill:PackedVector2Array = PackedVector2Array([Vector2.INF])
	var used_pass_points:Array[Vector2]
	for i in polygons.size():
		print(fill, \" ag \", polygons[i])
		if fill == PackedVector2Array([Vector2.INF]): # First polygon's the fill
			fill = polygons[i]
			print(\"!\")
			continue
		print(\"O\")
		# For all others, make them technically outside the fill with a placeholder point, then clip the polygon.
		
		var pass_point = Array(fill)#[0]
		print(\"UPTP\")
		print(used_pass_points)
		var best_pair := Vector2i(-1, -1)
		var best_dist = INF
		
		for i2 in fill.size():
			for j2 in polygons[i].size():
				
				var try_dist := fill[i2].distance_to(polygons[i][j2])
				
				if try_dist < best_dist:
					best_pair = Vector2i(i2, j2)
					best_dist = try_dist
		
		var from = polygons[i][best_pair.y] # Polygon
		var to = fill[best_pair.x] # Fill
		to = from + (from.direction_to(to) * from.distance_to(to) * 1.3)
		
		pass_point = pass_point[0]
		used_pass_points.append(pass_point)
		
		print(polygons[i], \" v \", fill)
		
		var new_polygon := polygons[i]
		
		#var outer_point = polygons[i][j] + (polygons[i][j].direction_to(pass_point) * polygons[i][j].distance_to(pass_point))
		#var inner_point = new_polygon[j]
		
		new_polygon.insert(best_pair.y, to)
		new_polygon.insert(best_pair.y, from + Vector2(0.1, 0.1).rotated(from.direction_to(to).angle()))
		#+= PackedVector2Array([new_polygon[0] + Vector2(0.001, 0.001).rotated(polygons[i][0].angle_to(pass_point)), outer_point])
		#
		
		print(new_polygon)
		
		print(\"CLIP\")
		polygons[i] = new_polygon
		print(\"C2 \", Geometry2D.clip_polygons(fill, new_polygon).size())
		fill = Geometry2D.clip_polygons(fill, new_polygon)[0]
	polygons[0] = fill
	print(polygons)
	
	while colliders.size() < polygons.size():
		var new := CollisionPolygon2D.new()
		
		new.owner = owner
		
		$StaticBody2D.add_child(new)
		
		colliders.append(new)
	
	for i in polygons.size():
		colliders[i].polygon = polygons[i]
		print(i, \" is \", Geometry2D.is_polygon_clockwise(polygons[i]))
	
	
	#colliders[0].polygon = Geometry2D.exclude_polygons(fill, polygons)
	
	for collider in colliders:
		collider.owner = self
"

