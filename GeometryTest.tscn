[sub_resource type="GDScript" id="GDScript_ywug1"]
script/source = "@tool
extends Line2D

@export var collider:CollisionPolygon2D
@export var attempt_holes := false

@export var offset := 0.0:
	set(to):
		offset = to
		regenerate.call()
@export_tool_button(\"REGENERATE\", \"Line2D\") var regenerate = func():
	
	if not collider: return
	
	if points.size() < 2: 
		collider.polygon = []
		return
	
	if attempt_holes:
		var fill:PackedVector2Array = PackedVector2Array([Vector2.INF])
		
		# Figure out what the polygon should be. Make a filled-in outline and cut holes out of it.
		for polygon in Geometry2D.offset_polyline(points, offset, Geometry2D.JOIN_MITER, Geometry2D.END_BUTT):
			
			# First polygon's the fill
			if fill == PackedVector2Array([Vector2.INF]): 
				fill = polygon
				continue
			
			
			# For all others, make them technically outside the fill 
			# with a placeholder point, then clip the polygon.
			
			# Get the pair of points from the hole and fill 
			# that are closest to each other
			var best_pair := Vector2i(-1, -1)
			var best_dist = INF
			
			for i2 in fill.size():
				for j2 in polygon.size():
					
					var try_dist := fill[i2].distance_to(polygon[j2])
					
					# If this pairs' distance is better, use it instead.
					if try_dist < best_dist:
						best_pair = Vector2i(i2, j2)
						best_dist = try_dist
			
			var from := polygon[best_pair.y] # Hole point
			var to   := fill[best_pair.x]    # Fill point
			
			# Push the 'to' point away from the hole point (from), 
			# so it cuts all the way through.
			to = from + (from.direction_to(to) * from.distance_to(to) * 1.3)
			
			# Add a minor vector to the from, since it'll get skipped if it's 
			# the same as the point it's copying.
			from += Vector2(0.001, 0.001).rotated(from.direction_to(to).angle())
			
			# Insert the outside point. This functions as a linear cut through the mesh.
			# This can fail, in which case the space is still filled, but this is an edge case anyway
			polygon.insert(best_pair.y, to)
			polygon.insert(best_pair.y, from)
			
			# Clip the current hole out of the fill.
			fill = Geometry2D.clip_polygons(fill, polygon)[0]
		
		collider.polygon = fill
	else:
		collider.polygon = Geometry2D.offset_polyline(points, offset, Geometry2D.JOIN_MITER, Geometry2D.END_BUTT)[0]

var lp:PackedVector2Array
func _process(delta: float) -> void:
	if lp != points:
		regenerate.call()
		lp = points
"

