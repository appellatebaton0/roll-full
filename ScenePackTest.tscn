[sub_resource type="GDScript" id="GDScript_y4vsk"]
script/source = "@tool
extends Node2D

# Hold onto nodes' old owners, so they get returned to what they should be after being packed.
var old_owners:Dictionary[Node,Node]

@export var target_node:Node
@export var target_path:StringName = \"res://test.tscn\"
@export_tool_button(\"PACK\") var pck := func():
	
	assure_user_directory(\"user://CustomLevelScenes\")
	assure_user_directory(\"user://CustomLevelData\")
	
	## oooh... opens a folder in userspace in the user's file manager. Could be sick for 
	## allowing custom music.
	OS.shell_show_in_file_manager(ProjectSettings.globalize_path(\"user://CustomLevelData\"))
	
	if not is_instance_valid(target_node):
		print(\"INVALID TARGET!\")
		return
	
	print(\"setting owners...\")
	recursive_owner_set()
	
	print(\"packing the scene...\")
	var scene := PackedScene.new()
	var result := scene.pack(target_node)
	
	if result == OK:
		var error = ResourceSaver.save(scene, target_path)  # Or \"user://...\"
		if error != OK:
			push_error(\"An error occurred while saving the scene to disk.\")
		else:
			print(\"packed!\")
	else:
		print(\"pack failed! error code \", result)
	
	# Reset all the owners
	reset_owners()

func recursive_owner_set(from:Node = target_node, new_owner:Node = target_node) -> void:
	if from == null: return
	
	for child in from.get_children():
		print(\"set \", child, \"'s owner to \", new_owner)
		old_owners[child] = child.owner
		child.owner = new_owner
		recursive_owner_set(child, new_owner)

func reset_owners() -> void:
	for node in old_owners:
		node.owner = old_owners[node]
	old_owners.clear()

func assure_user_directory(path:StringName) -> Error:
	if not DirAccess.dir_exists_absolute(path):
		return DirAccess.make_dir_absolute(path)
	return Error.OK
"

